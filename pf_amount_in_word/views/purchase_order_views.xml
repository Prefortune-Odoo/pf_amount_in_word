<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   
    <record id="purchase_order_form_inherit_amount_to_words" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.amount.to.words</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[hasclass('oe_subtotal_footer')]" position="after">
                <div class="clearfix"/>
                <div class="text-left" style="margin-top: 10px;">
                    <strong>Amount In Words: </strong>
                    <field name="amount_in_words" readonly="1" nolabel="1"/>
                    <span> only</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
