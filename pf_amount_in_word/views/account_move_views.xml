<?xml version="1.0" encoding="UTF-8" ?>
<data>
    <record id="view_move_form_inherit_amount_to_words" model="ir.ui.view">
        <field name="name">account.move.form.inherit.amount.to.words</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@class='oe_invoice_lines_tab overflow-hidden']" position="after">
               
                <div class="text-end">
                    <b style="margin-right:10px;">Amount In Words:  </b>
                    <field name="amount_in_words" readonly="1" force_save="1" />
                    only
                </div>
            </xpath>
        </field>
    </record>
</data>
