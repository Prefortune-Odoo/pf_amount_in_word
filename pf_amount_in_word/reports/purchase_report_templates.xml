<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   
    <template id="report_purchaseorder_document_inherit_amount_to_words" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[@id='total']" position="after">
            <div t-if="o.amount_in_words" class="mt-3">
                <strong>Amount In Word  :  </strong>
                <span t-field="o.amount_in_words" />
                only
            </div>
        </xpath>
    </template>

    <template id="report_purchasequotation_document_inherit_amount_to_words" inherit_id="purchase.report_purchasequotation_document">
            <xpath expr="//table" position="after">
                <div t-if="o.amount_in_words" class="mt-3">
                    <strong>Amount In Word : </strong>
                    <span t-field="o.amount_in_words"/>
                only
            </div>
        </xpath>
    </template>
</odoo>
